{
    "name": "sugarcommerce/discord",
    "version": "1.1.0",
    "description": "The Discord calls for giving a role on purchase: a bot invite link, user sign-in with PKCE, adding a member with a role, and taking the role back, with the DiscordBot User-Agent the API requires.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/sugarcommerce/discord",
    "authors": [
        {
            "name": "David Sherlock",
            "homepage": "https://arraypress.com/"
        }
    ],
    "keywords": [
        "discord",
        "oauth",
        "pkce",
        "roles",
        "guild",
        "bot",
        "membership"
    ],
    "require": {
        "php": ">=8.5",
        "sugarcommerce/http-client": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "SugarCommerce\\Discord\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCommerce\\Discord\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/sugarcommerce/discord/issues",
        "source": "https://github.com/sugarcommerce/discord"
    }
}
